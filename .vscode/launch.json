{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Bundle BFS GoogleTest",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/BundleBFSTrackerTest.exe",
      "args": ["--gtest_filter=${input:gtestFilter}"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [
        {
          "name": "PATH",
          "value": "C:/msys64/ucrt64/bin;C:/msys64/mingw64/bin;${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "CMake: Build Bundle BFS test for debugging",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "gtestFilter",
      "type": "promptString",
      "description": "GoogleTest filter (use * for all tests in this executable)",
      "default": "*"
    }
  ]
}
