{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Clean build folder",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "$target = Join-Path '${workspaceFolder}' 'build'; if (Test-Path -LiteralPath $target) { Remove-Item -LiteralPath $target -Recurse -Force }"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: Clean Build (MinGW Debug)",
      "dependsOn": [
        "CMake: Clean build folder",
        "CMake: Build"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure (MinGW Debug)",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build",
        "-G",
        "MinGW Makefiles",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: Build",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--parallel"],
      "dependsOn": "CMake: Configure (MinGW Debug)",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake: Run Tests",
      "type": "process",
      "command": "ctest",
      "args": [
        "--test-dir",
        "${workspaceFolder}/build",
        "--output-on-failure"
      ],
      "dependsOn": "CMake: Build",
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: Build Bundle BFS test for debugging",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--target",
        "BundleBFSTrackerTest"
      ],
      "dependsOn": "CMake: Configure (MinGW Debug)",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    }
  ]
}
